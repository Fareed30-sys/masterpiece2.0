PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/omnipulse
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/omnipulse?retryWrites=true&w=majority

JWT_SECRET=omnipulse_jwt_super_secret_production_key_2025
